# Server Configuration
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/einvoice

# Authentication Secrets
# WARNING: Generate secure random secrets for production!
# Generate JWT_SECRET: openssl rand -base64 32
# Generate JWT_REFRESH_SECRET: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_DIFFERENT_RANDOM_SECRET

# Encryption Key
# WARNING: Must be exactly 32 characters for AES-256 encryption
# Generate: openssl rand -hex 16
ENCRYPTION_KEY=CHANGE_THIS_32_CHAR_KEY_REQUIRED

# MyInvois API Configuration
MYINVOIS_BASE_URL=https://api.myinvois.hasil.gov.my

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Redis Configuration (required for Bull job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional: Redis connection URL (alternative to host/port)
# REDIS_URL=redis://localhost:6379
