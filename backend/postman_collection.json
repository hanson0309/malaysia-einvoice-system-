{
  "info": {
    "name": "Malaysia E-Invoice - IRB API",
    "description": "IRB MyInvois API 集成测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "invoice_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', response.token);",
                  "    console.log('Token saved:', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "IRB API",
      "item": [
        {
          "name": "Submit Invoice to IRB",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    console.log('UUID:', response.uuid);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/irb/submit/{{invoice_id}}",
              "host": ["{{base_url}}"],
              "path": ["irb", "submit", "{{invoice_id}}"]
            }
          }
        },
        {
          "name": "Get Invoice Status from IRB",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/irb/status/{{invoice_id}}",
              "host": ["{{base_url}}"],
              "path": ["irb", "status", "{{invoice_id}}"]
            }
          }
        },
        {
          "name": "TIN Lookup by NRIC",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nric\": \"123456789012\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/irb/tin-lookup",
              "host": ["{{base_url}}"],
              "path": ["irb", "tin-lookup"]
            }
          }
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "Create Invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('invoice_id', response._id);",
                  "    console.log('Invoice ID saved:', response._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"CUSTOMER_ID_HERE\",\n  \"invoice_type\": \"01\",\n  \"issue_date\": \"2025-05-02\",\n  \"currency\": \"MYR\",\n  \"items\": [\n    {\n      \"description\": \"Product 1\",\n      \"quantity\": 2,\n      \"unit_price\": 100.00,\n      \"tax_type\": \"SST\",\n      \"tax_rate\": 6,\n      \"tax_amount\": 12.00,\n      \"line_total\": 212.00\n    }\n  ],\n  \"subtotal\": 200.00,\n  \"tax_amount\": 12.00,\n  \"total_amount\": 212.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/invoices",
              "host": ["{{base_url}}"],
              "path": ["invoices"]
            }
          }
        },
        {
          "name": "Get Invoice",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/invoices/{{invoice_id}}",
              "host": ["{{base_url}}"],
              "path": ["invoices", "{{invoice_id}}"]
            }
          }
        },
        {
          "name": "List Invoices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/invoices",
              "host": ["{{base_url}}"],
              "path": ["invoices"]
            }
          }
        }
      ]
    }
  ]
}
